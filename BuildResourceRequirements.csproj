<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>BuildResourcesMod</AssemblyName>
    <RootNamespace>BuildResourcesModNamespace</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- ServerSync's source uses nullable annotations; enable the syntax without turning on nullable warnings for this project. -->
    <Nullable>annotations</Nullable>
    <OutputPath>bin/$(Configuration)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    Build paths. Override any of these on the command line, e.g.
      dotnet build -c Release -p:GamePath="D:\Steam\steamapps\common\Valheim" -p:BepInExCore="D:\BepInEx\core"
    GamePath   : Valheim install folder (Unity 6 / Valheim 1.0.x)
    BepInExCore: folder containing BepInEx.dll and 0Harmony.dll (BepInExPack_Valheim 5.4.2350 or newer)
  -->
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">$(GamePath)\valheim_Data\Managed</GameManagedPath>
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(GamePath)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="BuildResourceRequirements.cs" />
    <!-- ServerSync (https://github.com/blaxxun-boop/ServerSync) is a git submodule; its single source file is compiled
         straight into this assembly, so the plugin ships as one DLL with no ILRepack step.
         Run `git submodule update -\-init` after cloning. -->
    <Compile Include="ServerSync\ConfigSync.cs" />
  </ItemGroup>

  <Target Name="CheckServerSyncSubmodule" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)ServerSync\ConfigSync.cs')"
           Text="ServerSync submodule is missing. Run: git submodule update --init" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(GameManagedPath)\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(GameManagedPath)\assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(GameManagedPath)\assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManagedPath)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameManagedPath)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameManagedPath)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
